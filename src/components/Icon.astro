---
interface Props {
	name:
		| 'calendar'
		| 'user'
		| 'room'
		| 'check'
		| 'arrow'
		| 'phone'
		| 'pin'
		| 'clock'
		| 'camera'
		| 'chat'
		| 'menu'
		| 'close';
}

const { name } = Astro.props;
---

<svg
	class="icon"
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.25"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
>
	{
		name === 'calendar' && (
			<>
				<rect x="4" y="5" width="16" height="15" rx="1.5" />
				<path d="M4 10h16M8 3.5V7M16 3.5V7" />
			</>
		)
	}
	{
		name === 'user' && (
			<>
				<circle cx="12" cy="8" r="3" />
				<path d="M6 19.5c.8-3 2.8-4.5 6-4.5s5.2 1.5 6 4.5" />
			</>
		)
	}
	{
		name === 'room' && (
			<>
				<path d="M7 20.5V4.5h10v16" />
				<path d="M7 20.5h10" />
				<path d="M14.2 12.2h.1" />
			</>
		)
	}
	{
		name === 'check' && (
			<>
				<circle cx="12" cy="12" r="8" />
				<path d="M8.4 12.2l2.3 2.3 4.8-5.1" />
			</>
		)
	}
	{name === 'arrow' && <path d="M5 12h14M13 6l6 6-6 6" />}
	{
		name === 'phone' && (
			<>
				<rect x="8" y="3" width="8" height="18" rx="1.5" />
				<path d="M11 18h2" />
			</>
		)
	}
	{
		name === 'pin' && (
			<>
				<path d="M12 21s6-5.1 6-10a6 6 0 1 0-12 0c0 4.9 6 10 6 10z" />
				<circle cx="12" cy="11" r="1.8" />
			</>
		)
	}
	{
		name === 'clock' && (
			<>
				<circle cx="12" cy="12" r="8" />
				<path d="M12 8v4.5L15 15" />
			</>
		)
	}
	{
		name === 'camera' && (
			<>
				<path d="M4 8.5h3.2L8.8 6h6.4l1.6 2.5H20V19H4V8.5z" />
				<circle cx="12" cy="13.2" r="2.7" />
			</>
		)
	}
	{name === 'chat' && <path d="M5 6.5h14V15H8.5L5 18.2V6.5z" />}
	{name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
	{name === 'close' && <path d="M6 6l12 12M18 6L6 18" />}
</svg>
